# PlayToday foundation environment contract.
# Copy this file to .env.local for local development. Never commit .env.local.

# Server-only values. These must never use the NEXT_PUBLIC_ prefix.
APP_ENV=development
LOG_LEVEL=info
SUPABASE_SERVICE_ROLE_KEY=test-server-service-role-key-not-a-credential

# Client-safe values. Every NEXT_PUBLIC_ value is visible in browser bundles.
NEXT_PUBLIC_APP_NAME=PlayToday
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
