{
  "name": "@playtoday/ingestion-worker",
  "version": "0.0.0",
  "private": true,
  "description": "Executable PlayToday API-Football ingestion worker.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "sync": "tsx src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node ../../scripts/clean.mjs dist coverage"
  },
  "dependencies": {
    "@playtoday/bookmaker-adapters": "workspace:*",
    "@playtoday/database-types": "workspace:*",
    "@playtoday/sports-domain": "workspace:*",
    "@supabase/supabase-js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playtoday/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
