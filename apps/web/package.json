{
  "name": "@playtoday/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/run-web.mjs dev",
    "build": "node ../../scripts/run-web.mjs build",
    "start": "node ../../scripts/run-web.mjs start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
